          "name": "Retrieve usage statistics for an application",
          "request": {
            "name": "Retrieve usage statistics for an application",
            "description": {
              "content": "The Ably system can be queried to obtain usage statistics for a given application, and results are provided aggregated across all channels in use in the application in the specified period. Stats may be used to track usage against account quotas.",
              "type": "text/plain"
            },
            "url": {
