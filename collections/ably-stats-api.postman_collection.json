      "item": [
        {
          "name": "Retrieve usage statistics for an application",
          "id": "9ba0340a-6b9e-4cfb-862b-9def7e853500",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "description": "The version of the API you wish to use.",
                "key": "X-Ably-Version",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/stats?start=<string>&limit=100&end=now&direction=backwards&unit=minute&format=json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats"
              ],
              "query": [
