                "name": "rule_id",
                "value": "",
                "type": "path",
                "description": "The rule ID."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the <a href=\"https://ably.com/docs/general/webhooks\">rule</a> specified by the rule ID, for the application specified by application ID."
        },
