                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "keyName",
                  "description": "(Required) The [key name](https://www.ably.io/documentation/rest-api/token-request-spec#api-key-format) comprises of the app ID and key ID of an API key."
                }
